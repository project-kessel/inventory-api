{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Kessel Inventory Unified YAML Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "common", "reporters"],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "common": {
      "$ref": "#/definitions/schemaSection"
    },
    "reporters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "$ref": "#/definitions/jsonSchema"
          },
          "relations": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/relation"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "jsonSchema": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "schemaSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "relations"],
      "properties": {
        "schema": {
          "$ref": "#/definitions/jsonSchema"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relation"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "field", "cardinality"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_]*$"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "cardinality": {
          "enum": ["one", "many"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
